  const by = k => a.photos.filter(p => p.kind === k);
  const cover = a.photos.find(p => p.f === a.cover) || a.photos[0];
  const sq = p => p.w / p.h < 1.25, ls = p => p.w / p.h >= 1.2;
  const singles = [...by("gerecht").filter(sq).slice(0, 3), ...by("sfeer").filter(sq).slice(0, 1)];
  const wides = [...by("sfeer"), ...by("groep")].filter(p => p !== cover && ls(p)).slice(0, 2);
  const pick = [cover, ...singles, ...wides].filter(Boolean);
  $("#inbeeld-t").textContent = albumTitle(a) + " in beeld";
  $("#mosaic").innerHTML = pick.map((p, i) => tile("home", pick, i, i === 0 ? "big" : i > singles.length ? "wide" : "")).join("");
  $("#inbeeld").dataset.ready = "1";
}
let heroT = null;
function startHero() {
  const list = ALBUMS.flatMap(a => a.photos.filter(p => p.recipe && BYID[p.recipe] && p.w / p.h < 1.25));
  if (!list.length) return;
  const plate = $("#plate");
  plate.innerHTML = list.map((p, i) => `<img${i === 0 ? ' class="on"' : ""} src="${fsrc(p.album, p)}" alt="${esc(p.caption)}" ${i ? 'loading="lazy"' : ""}>`).join("");
  let i = 0;
  const show = () => {
    const p = list[i], r = BYID[p.recipe];
    plate.querySelectorAll("img").forEach((im, k) => im.classList.toggle("on", k === i));
    $("#platecap").href = "#recept-" + r.id;
    $("#platecap .pc-k").textContent = albumTitle(p.album);
    $("#platecap .pc-t").textContent = r.title;
  };
  show();
  if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
  let paused = false;
  plate.parentElement.addEventListener("mouseenter", () => paused = true);
  plate.parentElement.addEventListener("mouseleave", () => paused = false);
  heroT = setInterval(() => { if (paused || document.hidden || !onHome) return; i = (i + 1) % list.length; show(); }, 5000);
}
