    if (skip !== "tag" && st.tag.size && ![...st.tag].every(t => r.tags.includes(t))) continue;
    if (skip !== "year" && st.year.size && !r.years.some(y => st.year.has(y))) continue;
    if (skip !== "event" && st.event.size && !r.events.some(e => st.event.has(e))) continue;
    if (skip !== "multi" && st.multi.size && r.nLessons < 2) continue;
