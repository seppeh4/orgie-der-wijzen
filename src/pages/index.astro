---
// Orgie der Wijzen: de hele site is één pagina; recepten komen uit /recipes.json
---
<!doctype html>
<html lang="nl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="robots" content="noindex, nofollow">
<style is:global>body{margin:0}img{max-width:100%}[hidden]{display:none!important}</style>
<title>Orgie der Wijzen</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500&family=Manrope:wght@400;500;600;700&display=swap">
<style is:global>
/* Layout: culinary-school landing — brick-red hero with round plate cropped at the right edge → white page with rounded beige cards, red serif section titles, big numbered lists. Detail pages: brick header → beige lesson cards → recipe. */
:root {
  --brick: #a3412b;       /* hero + headers, both themes */
  --brick-deep: #87331f;
  --on-brick: #fbf1e7;
  --coral: #dd7458;       /* pill buttons */
  --bg: #fffcf9;          /* page */
  --card: #f4ece4;        /* beige cards */
  --ink: #2c211c;
  --muted: #7a6a60;
  --red: #a3412b;         /* section titles, numerals on light */
  --line: #e9ddd2;
  --mark: #f9d4bf;
  --shadow: 0 2px 6px rgba(60,30,20,.06), 0 18px 40px rgba(60,30,20,.10);
  --f-display: "Playfair Display", "Didot", Georgia, serif;
  --f-body: "Manrope", "Helvetica Neue", Arial, system-ui, sans-serif;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --bg: #1d1613; --card: #2b211d; --ink: #f5e9de; --muted: #bba89a; --red: #ec9b7f; --line: #3e302a;
    --mark: #7a3a24; --shadow: 0 2px 6px rgba(0,0,0,.3), 0 18px 40px rgba(0,0,0,.4);
    color-scheme: dark;
  }
}
:root[data-theme="dark"] {
  --bg: #1d1613; --card: #2b211d; --ink: #f5e9de; --muted: #bba89a; --red: #ec9b7f; --line: #3e302a;
  --mark: #7a3a24; --shadow: 0 2px 6px rgba(0,0,0,.3), 0 18px 40px rgba(0,0,0,.4);
  color-scheme: dark;
}
* { box-sizing: border-box; }
[hidden] { display: none !important; }
body { background: var(--bg); color: var(--ink); font-family: var(--f-body); font-size: 16px; line-height: 1.6; overflow-x: hidden; }
body { display: flex; flex-direction: column; min-height: calc(100vh - env(safe-area-inset-top, 0px) - env(safe-area-inset-bottom, 0px)); min-height: calc(100dvh - env(safe-area-inset-top, 0px) - env(safe-area-inset-bottom, 0px)); }
body > * { flex-shrink: 0; }
#detail { flex: 1 0 auto; }
button, input, select { font: inherit; color: inherit; }
:focus-visible { outline: 2px solid var(--coral); outline-offset: 2px; border-radius: 6px; }
mark { background: var(--mark); color: inherit; border-radius: 3px; padding: 0 1px; }
img { display: block; }
a { color: inherit; }
.wrap { max-width: 1440px; margin: 0 auto; padding-left: max(16px, env(safe-area-inset-left, 0px)); padding-right: max(16px, env(safe-area-inset-right, 0px)); }
.btn { display: inline-flex; align-items: center; justify-content: center; gap: 10px; background: var(--coral); color: #fff8f2; border: 0; padding: 14px 30px; font-weight: 600; font-size: .95rem; text-decoration: none; cursor: pointer; border-radius: 999px; box-shadow: 0 8px 20px rgba(80,20,5,.25); }
.btn:hover { filter: brightness(1.06); }
.btn-ghost { display: inline-flex; border: 1.5px solid var(--red); color: var(--red); border-radius: 999px; padding: 9px 20px; font-weight: 600; font-size: .88rem; text-decoration: none; background: none; cursor: pointer; }
.btn-ghost:hover { background: var(--red); color: var(--bg); }
.nb { white-space: nowrap; }
.sec-head { display: flex; justify-content: space-between; align-items: baseline; gap: 12px 24px; flex-wrap: wrap; margin-bottom: 28px; }
.sec-head h2 { font-family: var(--f-display); font-weight: 600; color: var(--red); font-size: clamp(1.9rem, 3.6vw, 2.7rem); line-height: 1.1; margin: 0; }
.sec-head a { font-size: .88rem; color: var(--muted); text-decoration: none; }
.sec-head a:hover { color: var(--red); }
.label { font-size: .7rem; letter-spacing: .14em; text-transform: uppercase; color: var(--muted); margin: 0 0 10px; font-weight: 700; }

/* Brick header (hero + detail headers) */
.top { background-color: var(--brick); color: var(--on-brick); position: relative; overflow: hidden;
  background-image: repeating-radial-gradient(circle at 12% 18%, transparent 0 46px, rgba(255,240,225,.05) 46px 47px), repeating-radial-gradient(circle at 70% 120%, transparent 0 60px, rgba(255,240,225,.04) 60px 61px); }
nav.wrap { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding-block: 22px; position: relative; z-index: 3; }
.logo { font-family: var(--f-display); font-weight: 600; font-size: 1.35rem; line-height: 1; text-decoration: none; letter-spacing: .01em; }
.links { display: flex; gap: 30px; font-size: .9rem; font-weight: 500; }
.links a { color: var(--on-brick); opacity: .85; text-decoration: none; }
.links a:hover { opacity: 1; }

.hero { position: static; padding-block: 36px 96px; min-height: 560px; }
.hero-copy { position: relative; z-index: 2; max-width: 640px; margin: 0 auto; text-align: center; transform: translateX(-12%); }
.badge { display: inline-flex; align-items: center; gap: 14px; font-size: .78rem; font-weight: 600; margin-bottom: 26px; }
.badge::before, .badge::after { content: ""; width: 70px; height: 1px; background: rgba(251,241,231,.5); }
.badge span { border: 1px solid rgba(251,241,231,.6); border-radius: 999px; padding: 4px 14px; }
.hero h1 { font-family: var(--f-display); font-weight: 600; font-size: clamp(3.2rem, 8vw, 6.6rem); line-height: .98; letter-spacing: -.01em; margin: 0; text-wrap: balance; }
.hero p.lead { max-width: 40ch; margin: 24px auto 34px; opacity: .88; font-size: 1.02rem; }
.hero .alt { display: block; margin-top: 18px; font-size: .9rem; color: var(--on-brick); opacity: .85; }
.plate { position: absolute; right: -120px; top: 54%; transform: translateY(-50%); width: 560px; aspect-ratio: 1; border-radius: 50%; overflow: hidden; box-shadow: 0 30px 60px rgba(40,10,0,.35), 0 0 0 14px rgba(251,241,231,.08); z-index: 1; }
.plate img { width: 100%; height: 100%; object-fit: cover; }
.platecap { position: absolute; right: 150px; bottom: 56px; z-index: 3; display: grid; grid-template-columns: minmax(0,1fr) auto; align-items: center; gap: 2px 14px; max-width: 330px; background: var(--bg); color: var(--ink); text-decoration: none; border-radius: 18px; padding: 12px 14px 12px 18px; box-shadow: 0 14px 30px rgba(40,10,0,.3); }
.platecap .pc-k { font-size: .68rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--red); grid-column: 1; }
.platecap .pc-t { font-family: var(--f-display); font-weight: 600; font-size: 1.02rem; line-height: 1.2; grid-column: 1; }
.platecap .pc-go { grid-column: 2; grid-row: 1 / span 2; width: 34px; height: 34px; border-radius: 50%; background: var(--coral); color: #fff8f2; display: grid; place-items: center; font-weight: 700; transition: transform .2s; }
.platecap:hover .pc-go { transform: translateX(3px); }

/* Home sections */
.section { padding-block: 80px 0; }
.fgrid { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 16px; }
.fcard { grid-column: span 2; background: var(--card); border-radius: 22px; padding: 26px 26px 0; display: flex; flex-direction: column; gap: 10px; min-width: 0; overflow: hidden; }
.fcard.pad { padding-bottom: 26px; }
.fcard:nth-child(4) { grid-column: 2 / span 2; }
.fcard h3 { font-family: var(--f-display); font-weight: 600; color: var(--red); font-size: 1.7rem; line-height: 1.1; margin: 0; font-variant-numeric: lining-nums; }
.fcard p { margin: 0; font-size: .92rem; color: var(--muted); }
.fcard .btn-ghost { align-self: flex-start; margin-top: 6px; }
.fcard .pic { margin: 8px -26px 0; height: 170px; object-fit: cover; width: calc(100% + 52px); max-width: none; }

.prog { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 40px 36px; }
.pitem { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 4px 18px; text-decoration: none; min-width: 0; }
.pitem .num { font-family: var(--f-display); font-weight: 500; font-size: 3rem; line-height: .9; color: var(--red); font-variant-numeric: lining-nums tabular-nums; }
.pitem h3 { font-family: var(--f-body); font-weight: 700; font-size: 1rem; margin: 0; }
.pitem:hover h3 { color: var(--red); }
.pitem ul { grid-column: 2; margin: 2px 0 0; padding: 0; list-style: none; font-size: .86rem; color: var(--muted); }
.pitem ul li { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.pitem .ev { font-size: .72rem; color: var(--red); font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }

/* Archive */
.bar { position: sticky; top: env(safe-area-inset-top, 0px); z-index: 5; background: var(--bg); padding-block: 12px; border-bottom: 1px solid var(--line); }
.bar .wrap { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
.search { flex: 1 1 320px; position: relative; min-width: 0; }
.search input { width: 100%; padding: 15px 18px 15px 50px; border-radius: 999px; border: 1.5px solid var(--line); background: var(--card); font-size: 1.02rem; }
.search input:focus { border-color: var(--coral); outline: none; }
.search svg { position: absolute; left: 18px; top: 50%; transform: translateY(-50%); width: 20px; height: 20px; stroke: var(--muted); fill: none; stroke-width: 2; }
.tabs { display: flex; background: var(--card); border-radius: 999px; padding: 4px; }
.tabs button { border: 0; background: none; padding: 10px 18px; border-radius: 999px; cursor: pointer; font-weight: 600; font-size: .9rem; }
.tabs button[aria-pressed="true"] { background: var(--red); color: var(--bg); }
.filter-toggle { display: none; border: 0; background: var(--card); border-radius: 999px; padding: 12px 18px; cursor: pointer; font-weight: 600; }

.main { display: grid; grid-template-columns: 270px minmax(0, 1fr); gap: 48px; padding-block: 28px 96px; }
aside { align-self: start; padding-bottom: 12px; }
.fhead { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding-bottom: 14px; border-bottom: 1px solid var(--line); }
.fhead h3 { margin: 0; font-size: 1rem; font-weight: 700; }
.clear { border: 0; background: none; padding: 0; cursor: pointer; color: var(--red); font-weight: 600; font-size: .85rem; }
.clear:hover { text-decoration: underline; }
.fclose { display: none; }
.fgroup { border-bottom: 1px solid var(--line); padding-block: 14px; }
.gtoggle { width: 100%; display: flex; justify-content: space-between; align-items: center; border: 0; background: none; padding: 0; cursor: pointer; font-weight: 600; font-size: .9rem; }
.gtoggle svg { width: 14px; height: 14px; stroke: var(--muted); fill: none; stroke-width: 2; transition: transform .2s; }
.gtoggle[aria-expanded="false"] svg { transform: rotate(-90deg); }
.gtoggle .gcount { margin-left: auto; margin-right: 8px; font-size: .7rem; font-weight: 700; background: var(--red); color: var(--bg); border-radius: 999px; padding: 0 7px; }
.opts { display: flex; flex-direction: column; gap: 1px; margin-top: 10px; }
.opt { display: grid; grid-template-columns: 18px minmax(0,1fr) auto; align-items: center; gap: 10px; padding: 5px 6px; margin: 0 -6px; border-radius: 8px; cursor: pointer; font-size: .88rem; }
.opt:hover { background: var(--card); }
.opt input { position: absolute; opacity: 0; pointer-events: none; }
.opt .box { width: 18px; height: 18px; border: 1.5px solid color-mix(in srgb, var(--ink) 35%, transparent); border-radius: 5px; display: grid; place-items: center; transition: background .15s, border-color .15s; }
.opt .box svg { width: 12px; height: 12px; stroke: var(--bg); fill: none; stroke-width: 3; opacity: 0; }
.opt input:checked + .box { background: var(--red); border-color: var(--red); }
.opt input:checked + .box svg { opacity: 1; }
.opt input:focus-visible + .box { outline: 2px solid var(--coral); outline-offset: 2px; }
.opt .t { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.opt .t::first-letter { text-transform: uppercase; }
.opt .n { font-size: .78rem; color: var(--muted); font-variant-numeric: tabular-nums; }
.opt.zero { opacity: .4; }
.showmore { border: 0; background: none; padding: 4px 0 0; cursor: pointer; color: var(--red); font-weight: 600; font-size: .82rem; align-self: flex-start; }
.fapply { display: none; }
.chips { display: flex; flex-wrap: wrap; gap: 6px; }
.chip { border: 0; background: var(--card); border-radius: 999px; padding: 5px 12px; cursor: pointer; font-size: .85rem; display: inline-flex; gap: 6px; align-items: baseline; }
.chip[aria-pressed="true"] { background: var(--red); color: var(--bg); }

.reshead { display: flex; justify-content: space-between; align-items: flex-end; gap: 12px 20px; flex-wrap: wrap; margin-bottom: 14px; }
.reshead h2 { font-family: var(--f-display); font-size: 1.9rem; margin: 0; font-weight: 600; line-height: 1.1; }
.rsub { margin: 4px 0 0; font-size: .85rem; color: var(--muted); }
.rtools { display: flex; gap: 8px; align-items: center; }
.sortsel { display: inline-flex; align-items: center; gap: 6px; border: 1px solid var(--line); border-radius: 10px; padding: 0 4px 0 12px; font-size: .82rem; color: var(--muted); background: var(--bg); }
.sortsel select { border: 0; background: none; padding: 8px 6px; font-size: .86rem; font-weight: 600; color: var(--ink); cursor: pointer; }
.viewtog { display: flex; border: 1px solid var(--line); border-radius: 10px; padding: 3px; gap: 2px; }
.viewtog button { border: 0; background: none; width: 32px; height: 30px; border-radius: 7px; cursor: pointer; display: grid; place-items: center; color: var(--muted); }
.viewtog button[aria-pressed="true"] { background: var(--ink); color: var(--bg); }
.viewtog svg { width: 16px; height: 16px; fill: currentColor; }
.activebar { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; min-height: 34px; padding-block: 4px 16px; font-size: .85rem; }
.activebar .of { color: var(--muted); margin-right: 4px; font-variant-numeric: tabular-nums; }
.achip { display: inline-flex; align-items: center; gap: 6px; border: 1px solid var(--line); background: var(--bg); border-radius: 8px; padding: 4px 8px 4px 11px; cursor: pointer; font-size: .82rem; font-weight: 500; }
.achip:hover { border-color: var(--red); }
.achip span { color: var(--muted); font-size: 1rem; line-height: 1; }
.activebar .clear { margin-left: 4px; }
.list.rows { grid-template-columns: minmax(0,1fr); gap: 0; border-top: 1px solid var(--line); }
.rows .card { display: grid; grid-template-columns: 150px minmax(0,1fr) auto; align-items: center; gap: 4px 24px; background: none; border-radius: 0; border-bottom: 1px solid var(--line); padding: 16px 6px; }
.rows .card:hover { box-shadow: none; transform: none; background: var(--card); }
.rows .card .meta { flex-direction: column; gap: 2px; }
.rows .card h4 { font-size: 1.2rem; }
.rows .card .snip { -webkit-line-clamp: 1; grid-column: 2; }
.rows .card .tags { grid-row: 1 / span 2; grid-column: 3; margin: 0; padding: 0; justify-content: flex-end; max-width: 220px; }
.rows .card .meta { grid-row: 1 / span 2; }
.list { display: grid; grid-template-columns: repeat(auto-fill, minmax(270px, 1fr)); gap: 16px; }
.card { text-decoration: none; background: var(--card); border-radius: 20px; padding: 22px 24px; display: flex; flex-direction: column; gap: 8px; min-width: 0; transition: box-shadow .2s, transform .2s; }
.card:hover { box-shadow: var(--shadow); transform: translateY(-2px); }
.card .meta { display: flex; justify-content: space-between; gap: 8px; font-size: .75rem; color: var(--muted); font-variant-numeric: tabular-nums; }
.course { font-weight: 700; font-size: .68rem; letter-spacing: .12em; text-transform: uppercase; color: var(--red); }
.card h4 { font-family: var(--f-display); font-weight: 600; font-size: 1.35rem; line-height: 1.18; margin: 0; text-wrap: balance; overflow-wrap: anywhere; }
.card .snip { font-size: .85rem; color: var(--muted); margin: 0; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.tags { display: flex; flex-wrap: wrap; gap: 4px; }
.card .tags { margin-top: auto; padding-top: 4px; }
.tagpill { font-size: .72rem; border: 1px solid var(--line); color: var(--muted); border-radius: 999px; padding: 0 9px; white-space: nowrap; background: var(--bg); }
.lady { background: var(--coral); border-color: var(--coral); color: #fff8f2; }
.multi { background: var(--red); border-color: var(--red); color: var(--bg); }
.empty { padding: 48px 0; text-align: center; color: var(--muted); }
.more { margin: 28px auto 0; display: block; }

/* Lessons list */
.season { margin-bottom: 36px; }
.season h3 { font-family: var(--f-display); font-weight: 600; color: var(--red); font-size: 1.4rem; margin: 0 0 6px; padding-bottom: 8px; border-bottom: 1px solid var(--line); }
.lesson { display: grid; grid-template-columns: 110px minmax(0,1fr); gap: 18px; padding: 16px 0; border-bottom: 1px solid var(--line); }
.lesson .d { font-size: .8rem; color: var(--muted); line-height: 1.3; text-decoration: none; }
.lesson a.d:hover b { color: var(--red); }
.lesson .d b { display: block; font-family: var(--f-display); font-weight: 500; font-size: 2.6rem; color: var(--ink); line-height: .9; font-variant-numeric: lining-nums tabular-nums; }
.lesson .d .go { display: inline-block; margin-top: 6px; color: var(--red); text-decoration: underline; font-weight: 600; }
.lesson ol { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 5px; }
.lesson li a { text-decoration: none; font-family: var(--f-display); font-size: 1.15rem; line-height: 1.25; }
.lesson li a:hover { color: var(--red); }
.lesson li .course { margin-right: 8px; display: inline-block; min-width: 108px; }

/* Detail pages */
.dhead { padding-block: 20px 72px; position: relative; z-index: 2; }
.back { display: inline-flex; gap: 8px; align-items: center; color: var(--on-brick); opacity: .8; text-decoration: none; font-size: .9rem; font-weight: 500; margin-bottom: 30px; }
.back:hover { opacity: 1; }
.dhead .badge { margin-bottom: 18px; }
.dhead .badge::before { display: none; }
.dhead .badge { flex-wrap: wrap; gap: 8px; }
.dhead .badge::after { display: none; }
.dhead h1 { font-family: var(--f-display); font-weight: 600; font-size: clamp(2.5rem, 6vw, 4.8rem); line-height: 1.02; letter-spacing: -.01em; margin: 0 0 18px; max-width: 20ch; text-wrap: balance; overflow-wrap: anywhere; }
.dhead h1 em { font-style: italic; font-weight: 500; }
.dhead .intro { font-style: italic; opacity: .85; max-width: 60ch; margin: 0 0 18px; }
.dhead .tagpill { border-color: rgba(251,241,231,.4); color: var(--on-brick); background: transparent; }
.dhead .tagpill.lady { background: var(--coral); border-color: var(--coral); }
.top .plate.small { width: 380px; right: -110px; opacity: .95; }

.lessons-band .wrap { padding-block: 64px 8px; }
.lessons-band .sub { margin: -16px 0 24px; font-size: .95rem; color: var(--muted); max-width: 62ch; }
.lgrid { display: grid; grid-template-columns: repeat(auto-fill, minmax(270px, 1fr)); gap: 16px; }
.lcard { background: var(--card); border-radius: 22px; padding: 24px; display: flex; flex-direction: column; gap: 10px; min-width: 0; border: 2px solid transparent; }
.lcard.current { border-color: var(--red); }
.lcard .when { display: flex; align-items: center; gap: 12px; }
.lcard .when b { font-family: var(--f-display); font-weight: 500; font-size: 3rem; line-height: .9; color: var(--red); font-variant-numeric: lining-nums tabular-nums; }
.lcard .when span { font-size: .85rem; color: var(--muted); line-height: 1.25; }
.lcard .row { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
.lcard .asname { font-size: .85rem; color: var(--muted); margin: 0; }
.lcard ul { list-style: none; margin: 0; padding: 12px 0 0; border-top: 1px solid var(--line); display: flex; flex-direction: column; gap: 4px; font-size: .9rem; }
.lcard ul a { text-decoration: none; }
.lcard ul a:hover { color: var(--red); text-decoration: underline; }
.lcard ul .course { font-size: .6rem; margin-right: 6px; }
.lcard .actions { margin-top: auto; padding-top: 6px; display: flex; flex-wrap: wrap; gap: 8px; }
.lcard .actions a, .lcard .actions button { font-size: .82rem; padding: 7px 16px; }
.vtag { font-size: .72rem; border-radius: 999px; padding: 0 9px; background: var(--bg); border: 1px solid var(--line); }

.dbody { padding-block: 56px 96px; }
.vswitch { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin-bottom: 28px; }
.vswitch .label { margin: 0 6px 0 0; }
.cols { display: grid; grid-template-columns: minmax(230px, 340px) minmax(0, 1fr); gap: 52px; }
.cols h3 { font-family: var(--f-display); font-weight: 600; color: var(--red); font-size: 1.6rem; margin: 0 0 14px; line-height: 1.1; }
.cols h3 small { font-family: var(--f-body); font-size: .8rem; color: var(--muted); font-weight: 500; }
.ing { background: var(--card); padding: 26px; align-self: start; border-radius: 22px; position: sticky; top: calc(env(safe-area-inset-top, 0px) + 16px); }
.ing h5, .steps h5 { font-family: var(--f-body); font-weight: 700; font-size: .95rem; margin: 18px 0 4px; }
.ing h5:first-of-type { margin-top: 0; }
.ing ul { margin: 0; padding: 0; list-style: none; }
.ing li { padding: 6px 0; border-bottom: 1px solid var(--line); font-size: .93rem; }
.ing li:last-child { border-bottom: 0; }
.steps p { margin: 0 0 14px; max-width: 68ch; font-size: 1.02rem; }
.tipbox { margin-top: 26px; background: var(--card); border-radius: 18px; padding: 18px 22px; }
