    const lines = [...(v.ingredients||[]).flatMap(g => g.items||[]), ...(v.steps||[]).map(s => s.text)];
    for (const t of T) { const l = lines.find(x => norm(x).includes(t)); if (l) {
      const i = norm(l).indexOf(t), a = Math.max(0, i - 50); return (a ? "…" : "") + hl(l.slice(a, a + 160), T); } }
  }
  if (r.cookbook) return "Recept uit een kookboek.";
  const items = (v.ingredients||[]).flatMap(g => g.items||[]);
  if (!items.length) return "Stond op het menu, zonder uitgeschreven recept.";
  return esc(items.slice(0, 6).map(x => x.replace(/^[\d.,/½¼¾\s]+(gr|g|kg|ml|cl|dl|l|el|kl|stuks?)?\.?\s+/i, "")).join(" · "));
}
const CHECK = '<svg viewBox="0 0 24 24"><path d="m5 12 5 5 9-10"/></svg>';
function optList(key, entries, max = 0) {
