  for (const [a,b] of ranges) { if (a < last) continue; res += esc(text.slice(last, a)) + "<mark>" + esc(text.slice(a, b)) + "</mark>"; last = b; }
  return res + esc(text.slice(last));
}
function snippet(r, T) {
