}
function season(iso) { if (!iso) return "Losse recepten"; const [y,m] = iso.split("-").map(Number); return m >= 8 ? `Seizoen ${y}–${y+1}` : `Seizoen ${y-1}–${y}`; }
const lkey = l => l.date + (l.event === "Ladiesnight" ? "-ladiesnight" : "");

/* ---------- data ---------- */
function prep(r) {
  r.versions = r.versions || []; r.lessons = r.lessons || []; r.tags = r.tags || [];
  r.main = r.versions[0] || { ingredients: [], steps: [], tips: [] };
  r.dated = r.lessons.filter(l => l.date);
  r.last = r.dated.length ? r.dated[0].date : "";
  r.years = [...new Set(r.dated.map(l => l.date.slice(0,4)))];
  if (!r.dated.length) r.years = ["—"];
  r.events = [...new Set(r.lessons.map(l => l.event))];
  r.nLessons = r.dated.length;
  r._t = norm(r.lessons.map(l => l.title).join(" ") + " " + r.title);
  r._i = norm(r.versions.flatMap(v => (v.ingredients||[]).flatMap(g => [g.group, ...(g.items||[])])).join(" "));
  r._s = norm([r.intro, ...r.versions.flatMap(v => [...(v.steps||[]).map(s => s.group + " " + s.text), ...(v.tips||[]), v.wine])].join(" "));
