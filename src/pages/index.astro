/* ---------- quantities & shopping list ---------- */
const LS = { get(k, d) { try { const v = JSON.parse(localStorage.getItem(k)); return v ?? d; } catch { return d; } }, set(k, v) { try { localStorage.setItem(k, JSON.stringify(v)); } catch {} } };
const FRAC = { "½": .5, "¼": .25, "¾": .75, "⅓": 1/3, "⅔": 2/3 };
const QN = String.raw`\d+\s+\d+\/\d+|\d+(?:[.,]\d+)?\s?[½¼¾⅓⅔]|\d+[.,]\d+|\d+\/\d+|\d+|[½¼¾⅓⅔]`;
const QRE = new RegExp(`^(\\s*)(${QN})(\\s*(?:-|–|à|a|tot|of)\\s*(${QN}))?`);
function qnum(t) {
  t = t.trim(); let m;
  if ((m = t.match(/^(\d+)\s+(\d+)\/(\d+)$/))) return +m[1] + m[2] / m[3];
  if ((m = t.match(/^(\d+(?:[.,]\d+)?)\s?([½¼¾⅓⅔])$/))) return parseFloat(m[1].replace(",", ".")) + FRAC[m[2]];
  if ((m = t.match(/^(\d+)\/(\d+)$/))) return m[1] / m[2];
  if (FRAC[t] != null) return FRAC[t];
  return parseFloat(t.replace(",", "."));
}
function qfmt(n) {
  if (n >= 100) return String(Math.round(n / 5) * 5);
  if (n >= 10) return String(Math.round(n));
  const w = Math.floor(n), f = n - w;
  const opts = [[0, ""], [.25, "¼"], [1/3, "⅓"], [.5, "½"], [2/3, "⅔"], [.75, "¾"], [1, ""]];
  const b = opts.reduce((a, c) => Math.abs(c[0] - f) < Math.abs(a[0] - f) ? c : a);
  if (Math.abs(b[0] - f) < .04) { const W = b[0] === 1 ? w + 1 : w; return ((W ? String(W) : "") + b[1]) || "0"; }
  return String(Math.round(n * 10) / 10).replace(".", ",");
}
function scaleLine(s, f) {
  const m = f === 1 ? null : QRE.exec(s);
  if (!m) return { text: s, scaled: false };
  const a = qnum(m[2]); if (!isFinite(a)) return { text: s, scaled: false };
  let q = qfmt(a * f);
  if (m[4]) { const b = qnum(m[4]); if (isFinite(b)) q += m[3].slice(0, m[3].lastIndexOf(m[4])) + qfmt(b * f); }
  return { text: m[1] + q + s.slice(m[0].length), q, rest: s.slice(m[0].length), lead: m[1], scaled: true };
}
const statedBase = v => { const m = (v && v.servings || "").match(/(\d+)/); return m ? +m[1] : null; };
const pkey = (id, vi) => id + "~" + vi;
function getPers(r, vi) {
  const s = LS.get("odw-pers", {})[pkey(r.id, vi)] || {};
  const b0 = statedBase(r.versions[vi]);
  const base = s.base ?? b0 ?? null;
  return { base, people: base ? (s.people ?? base) : null, stated: b0 != null };
}
function setPers(r, vi, o) { const all = LS.get("odw-pers", {}); all[pkey(r.id, vi)] = { ...(all[pkey(r.id, vi)] || {}), ...o }; LS.set("odw-pers", all); }
const stepper = (id, val, dis) => `<div class="stepper"><button type="button" data-step="${id}" data-d="-1" aria-label="Minder" ${dis ? "disabled" : ""}>−</button><input id="${id}" type="number" min="1" max="200" inputmode="numeric" placeholder="?" value="${val ?? ""}" ${dis ? "disabled" : ""} aria-label="${id === "p-base" ? "Recept voor aantal personen" : "Koken voor aantal personen"}"><button type="button" data-step="${id}" data-d="1" aria-label="Meer" ${dis ? "disabled" : ""}>+</button></div>`;
function persHtml(r, vi) {
  const p = getPers(r, vi);
  return `<div class="pers" id="pers">
    <div class="prow"><span>Recept voor</span>${stepper("p-base", p.base)}</div>
    <div class="prow"><span>Ik kook voor</span>${stepper("p-people", p.people, !p.base)}</div>
    ${p.stated ? "" : `<p class="phint" id="p-hint">${p.base ? "Aantal personen zelf ingevuld." : "Het recept vermeldt niet voor hoeveel personen het is. Vul het in, dan rekenen we de hoeveelheden om."}</p>`}
  </div>`;
}
let CUR = null;
function renderIng() {
  if (!CUR || !$("#ing-list")) return;
  const { r, vi } = CUR, v = r.versions[vi], p = getPers(r, vi);
  const f = p.base && p.people ? p.people / p.base : 1;
  const T = terms();
  $("#ing-list").innerHTML = (v.ingredients || []).map(g => `${g.group ? `<h5>${esc(g.group)}</h5>` : ""}<ul>${(g.items || []).map(i => {
    const sc = scaleLine(i, f);
    return sc.scaled ? `<li class="scaled">${esc(sc.lead)}<span class="q">${esc(sc.q)}</span>${hl(sc.rest, T)}</li>` : `<li>${hl(i, T)}</li>`;
  }).join("")}</ul>`).join("");
  const onList = shopList().items.some(x => x.id === r.id && x.vi === vi);
  const b = $("#add-list");
  b.classList.toggle("done", onList);
  b.textContent = onList ? `Op je lijst (voor ${p.people ?? "?"} pers.) · bijwerken` : `Zet op boodschappenlijst${p.people ? ` (${p.people} pers.)` : ""}`;
}
function syncPers() {
  if (!CUR) return;
  const { r, vi } = CUR, p = getPers(r, vi);
  const pi = $("#p-people"), dis = !p.base;
  pi.disabled = dis; pi.value = p.people ?? "";
  document.querySelectorAll('[data-step="p-people"]').forEach(b => b.disabled = dis);
  const h = $("#p-hint"); if (h) h.textContent = p.base ? "Aantal personen zelf ingevuld." : "Het recept vermeldt niet voor hoeveel personen het is. Vul het in, dan rekenen we de hoeveelheden om.";
  renderIng();
}
function persChange(id, val) {
  if (!CUR) return;
  const { r, vi } = CUR, p = getPers(r, vi);
  val = Math.max(1, Math.min(200, Math.round(val) || 0)) || null;
  if (id === "p-base") { setPers(r, vi, { base: val, people: p.people && p.base ? p.people : val }); $("#p-base").value = val ?? ""; }
  else setPers(r, vi, { people: val });
  syncPers();
}
/* list */
const shopList = () => LS.get("odw-lijst", { items: [], checked: {} });
const saveList = l => { LS.set("odw-lijst", l); updateCart(); };
function updateCart() { const n = shopList().items.length; $("#cart-n").hidden = !n; $("#cart-n").textContent = n; }
function addToList(r, vi, people, base) {
  const l = shopList();
  const it = { id: r.id, vi, base: base ?? null, people: people ?? null };
  const i = l.items.findIndex(x => x.id === r.id && x.vi === vi);
  if (i > -1) l.items[i] = it; else l.items.push(it);
  saveList(l);
}
function listLines(it) {
  const r = BYID[it.id], v = r && r.versions[it.vi]; if (!v) return [];
  const f = it.base && it.people ? it.people / it.base : 1;
  return (v.ingredients || []).map((g, gi) => ({ group: g.group, items: (g.items || []).map((x, ii) => ({ key: `${it.id}~${it.vi}|${gi}.${ii}`, text: scaleLine(x, f).text })) }));
}
let clearArmed = 0;
function renderShop() {
  const l = shopList();
  const n = l.items.reduce((a, it) => a + listLines(it).reduce((b, g) => b + g.items.length, 0), 0);
  $("#dhead").innerHTML = `<a class="back" href="#recepten">← Alle recepten</a>
    <p class="badge"><span>${l.items.length} ${l.items.length === 1 ? "gerecht" : "gerechten"}</span><span>${n} ingrediënten</span></p>
    <h1>Boodschappen<em>lijst</em></h1>`;
  if (!l.items.length) { $("#detail").innerHTML = `<div class="wrap dbody"><p class="note">Je lijst is nog leeg. Open een recept en klik op "Zet op boodschappenlijst", of zet een heel menu op je lijst vanaf de pagina van een les.</p><p><a class="btn" href="#recepten">Naar de recepten</a></p></div>`; return; }
  $("#detail").innerHTML = `<div class="wrap dbody">
    <div class="shop-tools"><button class="btn-ghost" id="shop-copy">Kopieer lijst</button><button class="btn-ghost" id="shop-uncheck">Vinkjes wissen</button><button class="btn-ghost" id="shop-clear">Lijst leegmaken</button><span class="note" id="shop-msg" aria-live="polite"></span></div>
    ${l.items.map((it, k) => { const r = BYID[it.id]; if (!r) return "";
      const lines = listLines(it);
      return `<section class="shop">
        <div class="shop-h"><h3><a href="#recept-${r.id}${it.vi ? "~v" + it.vi : ""}">${esc(r.title)}</a></h3>
          <div class="ctl">${it.base ? `<span>voor</span>${stepper("s-" + k, it.people)}<span>pers.</span>` : ""}<button class="xbtn" data-rmitem="${k}">Verwijderen</button></div></div>
        ${it.base ? "" : `<p class="warn">Niet omgerekend: het aantal personen van dit recept is niet ingevuld.</p>`}
        ${lines.map(g => `${g.group ? `<h5>${esc(g.group)}</h5>` : ""}<ul>${g.items.map(x => `<li><label><input type="checkbox" data-chk="${esc(x.key)}" ${l.checked[x.key] ? "checked" : ""}><span>${esc(x.text)}</span></label></li>`).join("")}</ul>`).join("")}
      </section>`; }).join("")}
  </div>`;
}
function shopText() {
  const l = shopList();
  return l.items.map(it => { const r = BYID[it.id]; if (!r) return "";
    return `${r.title}${it.people && it.base ? ` (voor ${it.people} pers.)` : ""}\n` + listLines(it).map(g => (g.group ? `  ${g.group}:\n` : "") + g.items.filter(x => !l.checked[x.key]).map(x => `  - ${x.text}`).join("\n")).join("\n"); }).join("\n\n");
}

/* ---------- router ---------- */
let homeScroll = 0, onHome = true, curHash = "";
function show(page) {
  document.querySelectorAll("[data-page]").forEach(el => el.hidden = el.dataset.page !== page);
}
function route() {
  const h = curHash.replace(/^#/, "");
  let m;
  if ((m = h.match(/^recept-([a-z0-9-]+?)(?:~v(\d+))?$/)) && BYID[m[1]]) {
    if (onHome) homeScroll = scrollY;
    onHome = false; show("detail"); renderRecipe(BYID[m[1]], m[2] ? +m[2] : null);
    document.title = BYID[m[1]].title + " · Orgie der Wijzen"; scrollTo(0, 0); return;
  }
  if (h === "boodschappen") {
    if (onHome) homeScroll = scrollY;
    onHome = false; show("detail"); CUR = null; renderShop(); document.title = "Boodschappenlijst · Orgie der Wijzen"; scrollTo(0, 0); return;
  }
  if (h === "fotos" || ((m = h.match(/^album-([a-z0-9-]+)$/)) && ABYID[m[1]])) {
    if (onHome) homeScroll = scrollY;
    onHome = false; show("detail");
    if (h === "fotos") { renderFotos(); document.title = "Foto's · Orgie der Wijzen"; }
    else { renderAlbum(ABYID[m[1]]); document.title = "Foto's " + fmtDate(ABYID[m[1]].date) + " · Orgie der Wijzen"; }
    scrollTo(0, 0); return;
  }
  if ((m = h.match(/^les-([0-9-]+(?:-ladiesnight)?)$/)) && LBYKEY[m[1]]) {
    if (onHome) homeScroll = scrollY;
    onHome = false; show("detail"); renderLesson(LBYKEY[m[1]]);
    document.title = LBYKEY[m[1]].event + " " + fmtDate(LBYKEY[m[1]].date) + " · Orgie der Wijzen"; scrollTo(0, 0); return;
  }
  const wasHome = onHome;
  onHome = true; show("home"); document.title = "Orgie der Wijzen";
  $("#inbeeld").hidden = !$("#inbeeld").dataset.ready;
  if (h === "kooklessen") setView("lessen");
  if (h === "recepten" && wasHome === false && st.view === "lessen") {}
  renderHome();
  const target = h === "kooklessen" ? "recepten" : h;
  if (target && document.getElementById(target)) {
    if (!wasHome && homeScroll && (h === "recepten" || h === "kooklessen")) scrollTo(0, homeScroll);
    else document.getElementById(target).scrollIntoView();
  } else scrollTo(0, wasHome ? scrollY : homeScroll);
}
function go(hash) {
  curHash = hash;
  try { history.pushState(null, "", hash || location.pathname + location.search); } catch {}
  route();
}
window.addEventListener("popstate", () => { curHash = location.hash; route(); });
window.addEventListener("hashchange", () => { if (location.hash !== curHash) { curHash = location.hash; route(); } });

function setView(v) { st.view = v; $("#tab-recepten").setAttribute("aria-pressed", v === "recepten"); $("#tab-lessen").setAttribute("aria-pressed", v === "lessen"); }

document.addEventListener("click", e => {
  const st_ = e.target.closest("[data-step]");
  if (st_) { const inp = $("#" + st_.dataset.step); const cur = +inp.value || (st_.dataset.step.startsWith("s-") ? 1 : 0);
    const nv = Math.max(1, cur + +st_.dataset.d || 1);
    if (st_.dataset.step.startsWith("s-")) { const k = +st_.dataset.step.slice(2), l = shopList(); l.items[k].people = Math.max(1, (l.items[k].people || 1) + +st_.dataset.d); saveList(l); renderShop(); }
    else persChange(st_.dataset.step, cur ? nv : (+st_.dataset.d > 0 ? 4 : 1));
    return; }
  if (e.target.closest("#add-list")) { const { r, vi } = CUR, p = getPers(r, vi); addToList(r, vi, p.people, p.base); renderIng(); return; }
  const ma = e.target.closest("#menu-add");
  if (ma) { const L = LBYKEY[ma.dataset.key]; let n = 0;
    for (const d of L.dishes) { if (d.l.v == null) continue; const p = getPers(d.r, d.l.v); addToList(d.r, d.l.v, p.people, p.base); n++; }
    ma.textContent = `${n} gerechten op je lijst ✓`; return; }
  const rmi = e.target.closest("[data-rmitem]");
  if (rmi) { const l = shopList(); l.items.splice(+rmi.dataset.rmitem, 1); saveList(l); renderShop(); return; }
  if (e.target.closest("#shop-uncheck")) { const l = shopList(); l.checked = {}; saveList(l); renderShop(); return; }
  if (e.target.closest("#shop-clear")) { const b = e.target.closest("#shop-clear");
    if (Date.now() - clearArmed < 4000) { saveList({ items: [], checked: {} }); renderShop(); clearArmed = 0; }
    else { clearArmed = Date.now(); b.textContent = "Zeker? Klik nog eens"; setTimeout(() => { if (b.isConnected) b.textContent = "Lijst leegmaken"; }, 4000); }
    return; }
  if (e.target.closest("#shop-copy")) { const t = shopText(), msg = $("#shop-msg");
    const done = () => msg.textContent = "Gekopieerd.";
    try { navigator.clipboard.writeText(t).then(done, () => { msg.textContent = "Kopiëren lukte niet; selecteer de lijst zelf."; }); } catch { msg.textContent = "Kopiëren lukte niet; selecteer de lijst zelf."; }
    return; }
  const t = e.target.closest("[data-lb]");
  if (t) { openLB(LBSETS[t.dataset.lb], +t.dataset.i); return; }
  if (e.target.closest("#lb-x") || e.target.id === "lb") { closeLB(); return; }
  if (e.target.closest("#lb-prev")) { stepLB(-1); return; }
  if (e.target.closest("#lb-next")) { stepLB(1); return; }
  if (e.target.closest("#lb a")) closeLB();
  const a = e.target.closest('a[href^="#"]');
  if (a && !e.metaKey && !e.ctrlKey) { e.preventDefault(); go(a.getAttribute("href") === "#" ? "" : a.getAttribute("href")); return; }
  const vb = e.target.closest("[data-ver]");
  if (vb) { const id = curHash.replace(/^#recept-/, "").replace(/~v\d+$/, ""); go(`#recept-${id}~v${vb.dataset.ver}`); return; }
  const rm = e.target.closest("[data-rm]");
  if (rm) { const k = rm.dataset.rm;
    if (k === "all") { FKEYS.forEach(f => st[f].clear()); st.q = ""; $("#q").value = ""; }
    else if (k === "q") { st.q = ""; $("#q").value = ""; }
    else st[k].delete(rm.dataset.v);
    st.limit = 60; renderHome(true); return; }
  const sm = e.target.closest("[data-more]");
  if (sm) { const k = sm.dataset.more; st.more.has(k) ? st.more.delete(k) : st.more.add(k); renderFilters(); return; }
  const gt = e.target.closest(".gtoggle");
  if (gt) { const k = gt.dataset.g; const open = st.closed.has(k); open ? st.closed.delete(k) : st.closed.add(k); gt.setAttribute("aria-expanded", open); $("#f-" + k).hidden = !open; return; }
  const lb = e.target.closest("[data-layout]");
  if (lb) { st.layout = lb.dataset.layout; document.querySelectorAll("[data-layout]").forEach(b => b.setAttribute("aria-pressed", b === lb)); renderHome(true); return; }
  if (e.target.id === "more") { st.limit += 60; renderHome(); }
});
document.addEventListener("keydown", e => {
  if (!$("#lb").hidden) { if (e.key === "Escape") closeLB(); if (e.key === "ArrowLeft") stepLB(-1); if (e.key === "ArrowRight") stepLB(1); return; }
  if (e.key === "/" && onHome && document.activeElement !== $("#q")) { e.preventDefault(); $("#q").focus(); }
});
let tmr; $("#q").addEventListener("input", e => { clearTimeout(tmr); tmr = setTimeout(() => { st.q = e.target.value; st.limit = 60; renderHome(true); }, 160); });
$("#sort").addEventListener("change", e => { st.sort = e.target.value; renderHome(true); });
$("#reset").addEventListener("click", () => { FKEYS.forEach(k => st[k].clear()); st.limit = 60; renderHome(true); });
document.addEventListener("change", e => {
  const c = e.target.closest("[data-chk]");
  if (c) { const l = shopList(); if (c.checked) l.checked[c.dataset.chk] = true; else delete l.checked[c.dataset.chk]; saveList(l); return; }
  if (e.target.id === "p-base" || e.target.id === "p-people") { persChange(e.target.id, +e.target.value); return; }
  const sp = e.target.id && e.target.id.match(/^s-(\d+)$/);
  if (sp) { const l = shopList(); l.items[+sp[1]].people = Math.max(1, Math.round(+e.target.value) || 1); saveList(l); renderShop(); }
});
$("#filters").addEventListener("change", e => { const i = e.target.closest("input[data-k]"); if (!i) return; const set = st[i.dataset.k]; i.checked ? set.add(i.dataset.v) : set.delete(i.dataset.v); st.limit = 60; renderHome(true); });
const closeFilters = () => { $("#filters").classList.remove("open"); $("#ftoggle").setAttribute("aria-expanded", false); document.body.style.overflow = ""; };
$("#fclose").addEventListener("click", closeFilters);
$("#fapply").addEventListener("click", () => { closeFilters(); $("#recepten .bar").scrollIntoView(); });
for (const v of ["recepten","lessen"]) $("#tab-" + v).addEventListener("click", () => { setView(v); renderHome(); });
let tx = null;
$("#lb").addEventListener("touchstart", e => { tx = e.touches[0].clientX; }, { passive: true });
$("#lb").addEventListener("touchend", e => { if (tx == null) return; const dx = e.changedTouches[0].clientX - tx; if (Math.abs(dx) > 50) stepLB(dx < 0 ? 1 : -1); tx = null; });
$("#ftoggle").addEventListener("click", () => { $("#filters").classList.add("open"); $("#ftoggle").setAttribute("aria-expanded", true); document.body.style.overflow = "hidden"; });

Promise.all([fetch("recipes.json").then(r => r.json()), fetch("fotos.json").then(r => r.ok ? r.json() : { albums: [] }).catch(() => ({ albums: [] }))]).then(([data, fotos]) => {
  R = data.map(prep);
  prepFotos(fotos);
  buildLessons();
  const years = LESSONS.map(L => +L.date.slice(0,4));
  renderMosaic();
  startHero();
  updateCart();
  $("#n-rec").textContent = R.length + " recepten";
  $("#n-les").textContent = LESSONS.length + " kooklessen";
  $("#n-first").textContent = Math.min(...years);
  $("#latest").innerHTML = LESSONS.slice(0, 6).map((L, i) => `<a class="pitem" href="#les-${L.key}">
    <span class="num">${String(i+1).padStart(2,"0")}</span>
    <div><span class="ev">${season(L.date)}</span><h3>${fmtDate(L.date, "long")}</h3></div>
    <ul>${L.dishes.slice(0, 4).map(d => `<li>${esc(d.l.title)}</li>`).join("")}${L.dishes.length > 4 ? `<li>+ ${L.dishes.length - 4} meer</li>` : ""}</ul>
  </a>`).join("");
  curHash = location.hash;
  route();
}).catch(err => { console.error(err); $("#count").textContent = "De recepten konden niet geladen worden. Herlaad de pagina."; });
</script>

</body>
</html>
