<script is:inline>
const COURSES = [
  ["aperitiefhapje","Aperitiefhapje"],["voorgerecht","Voorgerecht"],["soep","Soep"],["tussengerecht","Tussengerecht"],
  ["hoofdgerecht","Hoofdgerecht"],["bijgerecht","Bijgerecht"],["dessert","Dessert"],["saus-basis","Saus & basis"],["drank","Drank"]];
const COURSE_LABEL = Object.fromEntries(COURSES);
const CO = Object.fromEntries(COURSES.map((c,i)=>[c[0],i]));
const MONTHS = ["januari","februari","maart","april","mei","juni","juli","augustus","september","oktober","november","december"];
const MON = ["jan","feb","mrt","apr","mei","jun","jul","aug","sep","okt","nov","dec"];
const DAYS =["zondag","maandag","dinsdag","woensdag","donderdag","vrijdag","zaterdag"];
const $ = s => document.querySelector(s);
const esc = s => String(s ?? "").replace(/[&<>"]/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));
const norm = s => String(s ?? "").normalize("NFD").replace(/[̀-ͯ]/g, "").toLowerCase();
const cl = c => COURSE_LABEL[c] || c || "";

const FKEYS = ["course","tag","year","event","multi"];
const FNAMES = { course: "Gang", tag: "Soort", year: "Jaar", event: "Gelegenheid", multi: "Herhaald" };
let R = [], BYID = {}, LESSONS = [], LBYKEY = {};
const st = { q: "", course: new Set(), tag: new Set(), year: new Set(), event: new Set(), multi: new Set(), view: "recepten", sort: "new", limit: 60, layout: "grid", more: new Set(), closed: new Set() };

function fmtDate(iso, style) {
  if (!iso) return "Zonder datum";
  const [y,m,d] = iso.split("-").map(Number);
  const dt = new Date(y, m-1, d);
  if (style === "long") return `${DAYS[dt.getDay()]} ${d} ${MONTHS[m-1]} ${y}`;
  return `${d} ${MON[m-1]} ${y}`;
}
function season(iso) { if (!iso) return "Losse recepten"; const [y,m] = iso.split("-").map(Number); return m >= 8 ? `Seizoen ${y}–${y+1}` : `Seizoen ${y-1}–${y}`; }
const lkey = l => l.date + (l.event === "Ladiesnight" ? "-ladiesnight" : "");

/* ---------- data ---------- */
function prep(r) {
  r.versions = r.versions || []; r.lessons = r.lessons || []; r.tags = r.tags || [];
  r.main = r.versions[0] || { ingredients: [], steps: [], tips: [] };
  r.dated = r.lessons.filter(l => l.date);
  r.last = r.dated.length ? r.dated[0].date : "";
  r.years = [...new Set(r.dated.map(l => l.date.slice(0,4)))];
  if (!r.dated.length) r.years = ["—"];
  r.events = [...new Set(r.lessons.map(l => l.event))];
  r.nLessons = r.dated.length;
  r._t = norm(r.lessons.map(l => l.title).join(" ") + " " + r.title);
  r._i = norm(r.versions.flatMap(v => (v.ingredients||[]).flatMap(g => [g.group, ...(g.items||[])])).join(" "));
  r._s = norm([r.intro, ...r.versions.flatMap(v => [...(v.steps||[]).map(s => s.group + " " + s.text), ...(v.tips||[]), v.wine])].join(" "));
  BYID[r.id] = r;
  return r;
}
function buildLessons() {
  const m = new Map();
  for (const r of R) for (const l of r.lessons) {
    if (!l.date) continue;
    const k = lkey(l);
    if (!m.has(k)) m.set(k, { key: k, date: l.date, event: l.event, dishes: [], sources: new Set() });
    const L = m.get(k);
    L.dishes.push({ r, l });
    if (l.source) L.sources.add(l.source);
  }
  LESSONS = [...m.values()].sort((a,b) => b.key.localeCompare(a.key));
  for (const L of LESSONS) { L.dishes.sort((a,b) => (CO[a.l.course]??9)-(CO[b.l.course]??9)); LBYKEY[L.key] = L; }
}

/* ---------- search & filters ---------- */
function score(r, terms) {
  let s = 0;
  for (const t of terms) {
    let hit = 0;
    if (r._t.includes(t)) hit += 10 + (r._t.startsWith(t) ? 3 : 0);
    if (r._i.includes(t)) hit += 4;
    if (r._s.includes(t)) hit += 1;
    if (r.tags.includes(t) || norm(cl(r.course)).includes(t)) hit += 3;
    if (!hit) return 0;
    s += hit;
  }
  return s;
}
const terms = () => norm(st.q).split(/\s+/).filter(Boolean);
function filtered(skip) {
  const T = terms(), out = [];
  for (const r of R) {
    if (skip !== "course" && st.course.size && !st.course.has(r.course)) continue;
    if (skip !== "tag" && st.tag.size && ![...st.tag].every(t => r.tags.includes(t))) continue;
    if (skip !== "year" && st.year.size && !r.years.some(y => st.year.has(y))) continue;
    if (skip !== "event" && st.event.size && !r.events.some(e => st.event.has(e))) continue;
    if (skip !== "multi" && st.multi.size && r.nLessons < 2) continue;
    const sc = T.length ? score(r, T) : 1;
    if (sc) out.push([r, sc]);
  }
  return [out, T];
}
function hl(text, T) {
  text = String(text ?? "");
  if (!T.length) return esc(text);
  const n = norm(text), ranges = [];
  for (const t of T) { let i = 0; while ((i = n.indexOf(t, i)) > -1) { ranges.push([i, i + t.length]); i += t.length; } }
  if (!ranges.length) return esc(text);
  ranges.sort((a,b) => a[0]-b[0]);
  let res = "", last = 0;
  for (const [a,b] of ranges) { if (a < last) continue; res += esc(text.slice(last, a)) + "<mark>" + esc(text.slice(a, b)) + "</mark>"; last = b; }
  return res + esc(text.slice(last));
}
function snippet(r, T) {
  const v = r.main;
  if (T.length) {
    const lines = [...(v.ingredients||[]).flatMap(g => g.items||[]), ...(v.steps||[]).map(s => s.text)];
    for (const t of T) { const l = lines.find(x => norm(x).includes(t)); if (l) {
      const i = norm(l).indexOf(t), a = Math.max(0, i - 50); return (a ? "…" : "") + hl(l.slice(a, a + 160), T); } }
  }
  if (r.cookbook) return "Recept uit een kookboek.";
  const items = (v.ingredients||[]).flatMap(g => g.items||[]);
  if (!items.length) return "Stond op het menu, zonder uitgeschreven recept.";
  return esc(items.slice(0, 6).map(x => x.replace(/^[\d.,/½¼¾\s]+(gr|g|kg|ml|cl|dl|l|el|kl|stuks?)?\.?\s+/i, "")).join(" · "));
}
const CHECK = '<svg viewBox="0 0 24 24"><path d="m5 12 5 5 9-10"/></svg>';
function optList(key, entries, max = 0) {
  const el = $("#f-" + key);
  const showAll = !max || st.more.has(key) || entries.length <= max + 1;
  const vis = showAll ? entries : entries.slice(0, max);
  el.innerHTML = vis.map(([v, label, n]) =>
    `<label class="opt${n || st[key].has(v) ? "" : " zero"}"><input type="checkbox" data-k="${key}" data-v="${esc(v)}" ${st[key].has(v) ? "checked" : ""}><span class="box">${CHECK}</span><span class="t">${esc(label)}</span><span class="n">${n}</span></label>`).join("") +
    (max && entries.length > max + 1 ? `<button class="showmore" data-more="${key}">${showAll ? "Toon minder" : `Toon alle ${entries.length}`}</button>` : "");
  el.hidden = st.closed.has(key);
  const gc = $("#gc-" + key); gc.hidden = !st[key].size; gc.textContent = st[key].size;
}
function countBy(list, fn) { const m = new Map(); for (const [r] of list) for (const k of [].concat(fn(r))) m.set(k, (m.get(k)||0)+1); return m; }
const nActive = () => FKEYS.reduce((a, k) => a + st[k].size, 0);
function renderFilters() {
  const cc = countBy(filtered("course")[0], r => r.course);
  optList("course", COURSES.filter(([k]) => R.some(r => r.course === k)).map(([k,l]) => [k, l, cc.get(k)||0]));
  const tc = countBy(filtered("tag")[0], r => r.tags);
  const allTags = [...new Set(R.flatMap(r => r.tags))];
  optList("tag", allTags.sort((a,b) => (tc.get(b)||0)-(tc.get(a)||0) || a.localeCompare(b)).map(t => [t, t, tc.get(t)||0]), 7);
  const yc = countBy(filtered("year")[0], r => r.years);
  optList("year", [...new Set(R.flatMap(r => r.years))].sort().reverse().map(y => [y, y === "—" ? "Losse recepten" : y, yc.get(y)||0]), 6);
  const ec = countBy(filtered("event")[0], r => r.events);
  optList("event", [...new Set(R.flatMap(r => r.events))].map(e => [e, e, ec.get(e)||0]));
  const mc = filtered("multi")[0].filter(([r]) => r.nLessons > 1).length;
  optList("multi", [["ja", "In meerdere lessen", mc]]);
  const n = nActive();
  $("#reset").hidden = !n; $("#reset").textContent = `Wissen (${n})`;
  $("#fbadge").hidden = !n; $("#fbadge").textContent = n;
}
function labelOf(k, v) {
  if (k === "course") return cl(v);
  if (k === "year") return v === "—" ? "Losse recepten" : v;
  if (k === "multi") return "In meerdere lessen";
  return v.charAt(0).toUpperCase() + v.slice(1);
}
function renderActive(shown, total, noun) {
  const chipsHtml = [
    ...(st.q.trim() ? [`<button class="achip" data-rm="q">“${esc(st.q.trim())}” <span aria-hidden="true">×</span></button>`] : []),
    ...FKEYS.flatMap(k => [...st[k]].map(v => `<button class="achip" data-rm="${k}" data-v="${esc(v)}" aria-label="Verwijder filter ${esc(labelOf(k, v))}">${esc(labelOf(k, v))} <span aria-hidden="true">×</span></button>`))];
  $("#active").innerHTML = chipsHtml.length ? `<span class="of">${shown} van ${total} ${noun}</span>${chipsHtml.join("")}<button class="clear" data-rm="all">Alles wissen</button>` : "";
}

/* ---------- home ---------- */
function card(r, T) {
  return `<a class="card" href="#recept-${r.id}">
    <div class="meta"><span class="course">${esc(cl(r.course))}</span><span>${r.last ? fmtDate(r.last) : "los recept"}</span></div>
    <h4>${hl(r.title, T)}</h4>
    <p class="snip">${snippet(r, T)}</p>
    <div class="tags">${r.tags.slice(0,3).map(t => `<span class="tagpill">${esc(t)}</span>`).join("")}</div>
  </a>`;
}
function renderHome(fade) {
  renderFilters();
  if (fade && !matchMedia("(prefers-reduced-motion: reduce)").matches) $("#out").animate([{ opacity: .3, transform: "translateY(6px)" }, { opacity: 1, transform: "none" }], { duration: 260, easing: "ease-out" });
  const [list, T] = filtered();
  const byDate = (a,b) => b[0].last.localeCompare(a[0].last) || (CO[a[0].course]??9) - (CO[b[0].course]??9);
  if (T.length && st.sort === "new") list.sort((a,b) => b[1]-a[1] || byDate(a,b));
  else if (st.sort === "az") list.sort((a,b) => a[0].title.localeCompare(b[0].title, "nl"));
  else if (st.sort === "old") list.sort((a,b) => -byDate(a,b));
  else list.sort(byDate);
  const out = $("#out");
  if (st.view === "recepten") {
    $("#rtools").hidden = false; $("#rtitle").textContent = "Alle recepten";
    const sortName = T.length && st.sort === "new" ? "beste match" : $("#sort").selectedOptions[0].text.toLowerCase();
    $("#count").textContent = `${list.length} ${list.length === 1 ? "recept" : "recepten"} · gesorteerd op ${sortName}`;
    renderActive(list.length, R.length, "recepten");
    $("#fapply").textContent = `Toon ${list.length} ${list.length === 1 ? "recept" : "recepten"}`;
    if (!list.length) { out.innerHTML = `<p class="empty">Niets gevonden${st.q.trim() ? ` voor “${esc(st.q.trim())}”` : ""}. Probeer een ander woord of wis de filters.</p>`; return; }
    out.innerHTML = `<div class="list${st.layout === "rows" ? " rows" : ""}">${list.slice(0, st.limit).map(([r]) => card(r, T)).join("")}</div>` +
      (list.length > st.limit ? `<button class="more btn-ghost" id="more">Toon meer (${list.length - st.limit} resterend)</button>` : "");
  } else {
    $("#rtools").hidden = true; $("#rtitle").textContent = "Alle kooklessen";
    const keep = new Set(list.map(([r]) => r.id));
    const ls = LESSONS.filter(L => (!st.year.size || st.year.has(L.date.slice(0,4))) && (!st.event.size || st.event.has(L.event)))
      .map(L => ({ L, dishes: L.dishes.filter(d => keep.has(d.r.id)) })).filter(x => x.dishes.length);
    $("#count").textContent = `${ls.length} ${ls.length === 1 ? "kookles" : "kooklessen"} · nieuwste eerst`;
    renderActive(ls.length, LESSONS.length, "kooklessen");
    $("#fapply").textContent = `Toon ${ls.length} kooklessen`;
    if (!ls.length) { out.innerHTML = `<p class="empty">Geen kooklessen met deze zoekopdracht.</p>`; return; }
    let html = "", cur = "";
    for (const { L, dishes } of ls) {
      const s = season(L.date);
      if (s !== cur) { html += (cur ? "</div>" : "") + `<div class="season"><h3>${s}</h3>`; cur = s; }
      const [y,m,d] = L.date.split("-");
      html += `<div class="lesson"><a class="d" href="#les-${L.key}"><b>${+d}</b>${MON[+m-1]} ${y}<br><span class="go">Bekijk les</span></a>
        <ol>${dishes.map(({r, l}) => `<li><span class="course">${esc(cl(l.course))}</span><a href="#recept-${r.id}">${hl(l.title, T)}</a></li>`).join("")}</ol></div>`;
    }
    out.innerHTML = html + "</div>";
  }
}

/* ---------- recipe page ---------- */
function versionHtml(v, T) {
  let lastG = null;
  const ing = (v.ingredients||[]).map(g => `${g.group ? `<h5>${esc(g.group)}</h5>` : ""}<ul>${(g.items||[]).map(i => `<li>${hl(i, T)}</li>`).join("")}</ul>`).join("");
  const steps = (v.steps||[]).map(s => { const h = s.group && s.group !== lastG ? `<h5>${esc(s.group)}</h5>` : ""; lastG = s.group; return h + `<p>${hl(s.text, T)}</p>`; }).join("");
  return `<div class="cols">
    <div class="ing"><h3>Ingrediënten${v.servings ? ` <small>${esc(v.servings)}</small>` : ""}</h3>${ing || '<p class="note">Geen ingrediëntenlijst in het document.</p>'}</div>
    <div class="steps"><h3>Bereiding</h3>${steps || '<p class="note">Geen bereiding in het document.</p>'}
      ${(v.tips||[]).length ? `<div class="tipbox"><h3>Tips</h3>${v.tips.map(t => `<p>${esc(t)}</p>`).join("")}</div>` : ""}
      ${v.wine ? `<div class="tipbox"><h3>Wijn</h3><p>${esc(v.wine)}</p></div>` : ""}
    </div></div>`;
}
const vLetter = i => String.fromCharCode(65 + i);
function renderRecipe(r, vi) {
  const T = terms();
  const nv = r.versions.length;
  if (vi == null || vi >= nv) vi = 0;
  const dated = r.dated, loose = r.lessons.filter(l => !l.date);
  const sub = dated.length > 1 ? `Dit gerecht stond op het menu van ${dated.length} kooklessen` : dated.length ? "Gemaakt in de kookles" : "Los recept";
  $("#dhead").innerHTML = `<a class="back" href="#recepten">← Alle recepten</a>
    <p class="badge"><span>${esc(cl(r.course))}</span><span>${dated.length ? dated.length + (dated.length > 1 ? " lessen" : " les") : "los recept"}</span>${r.last ? `<span>laatst ${fmtDate(r.last)}</span>` : ""}</p>
    <h1>${esc(r.title)}</h1>
    ${r.intro ? `<p class="intro">${esc(r.intro)}</p>` : ""}
    <div class="tags">${r.events.includes("Ladiesnight") ? '<span class="tagpill lady">ladiesnight</span>' : ""}${r.tags.map(t => `<span class="tagpill">${esc(t)}</span>`).join("")}</div>`;
  const lcards = dated.map(l => {
    const L = LBYKEY[lkey(l)];
    const others = L ? L.dishes.filter(d => d.r !== r) : [];
    const [y,m,d] = l.date.split("-").map(Number);
    const dt = new Date(y, m-1, d);
    return `<article class="lcard${l.v === vi && nv > 1 ? " current" : ""}">
      <div class="when"><b>${d}</b><span>${DAYS[dt.getDay()]}<br>${MONTHS[m-1]} ${y}</span></div>
      <div class="row"><span class="tagpill ${l.event === "Ladiesnight" ? "lady" : ""}">${esc(l.event)}</span><span class="course">als ${esc(cl(l.course).toLowerCase())}</span>
        ${nv > 1 && l.v != null ? `<span class="vtag">versie ${vLetter(l.v)}</span>` : ""}${l.v == null ? `<span class="vtag">geen uitgeschreven recept</span>` : ""}</div>
      ${norm(l.title) !== norm(r.title) ? `<p class="asname">Op het menu als “${esc(l.title)}”</p>` : ""}
      ${others.length && dated.length === 1 ? `<ul><li class="label" style="margin:0">Ook op het menu</li>${others.slice(0, 5).map(o => `<li><span class="course">${esc(cl(o.l.course))}</span><a href="#recept-${o.r.id}">${esc(o.l.title)}</a></li>`).join("")}${others.length > 5 ? `<li><a href="#les-${lkey(l)}">+ ${others.length - 5} meer gerechten</a></li>` : ""}</ul>` : ""}
      <div class="actions"><a class="btn-ghost" href="#les-${lkey(l)}">Bekijk deze les</a>${nv > 1 && l.v != null && l.v !== vi ? `<button class="btn-ghost" data-ver="${l.v}">Toon versie ${vLetter(l.v)}</button>` : ""}</div>
    </article>`;
  }).join("");
  const looseNote = "";
  const vsw = nv > 1 ? `<div class="vswitch"><span class="label">Versie</span>${r.versions.map((v, i) => {
      const when = r.lessons.filter(l => l.v === i).map(l => l.date ? fmtDate(l.date) : "los recept").join(", ");
      return `<button class="chip" data-ver="${i}" aria-pressed="${i === vi}">${vLetter(i)} · ${esc(when)}</button>`; }).join("")}</div>` : "";
  const body = r.cookbook ? `<p class="note">Dit recept komt uit een kookboek dat in de les gebruikt werd.</p>`
    : nv ? vsw + versionHtml(r.versions[vi], T) : `<p class="note">Dit gerecht stond op het menu, maar het recept zit niet in het document.</p>`;
  $("#detail").innerHTML = `${dated.length ? `<section class="band lessons-band"><div class="wrap">
      <div class="sec-head" style="margin-bottom:24px"><h2>${dated.length > 1 ? `In ${dated.length} kooklessen` : "In deze kookles"}</h2></div>
      <p class="sub">${sub}${nv > 1 ? `, in ${nv} verschillende versies. Kies hieronder welke versie je wil zien.` : "."}</p>
      <div class="lgrid">${lcards}</div>${looseNote}</div></section>` : ""}
    <div class="wrap dbody">${body}</div>`;
}

/* ---------- lesson page ---------- */
function renderLesson(L) {
  const T = terms();
  const i = LESSONS.indexOf(L), newer = LESSONS[i-1], older = LESSONS[i+1];
  $("#dhead").innerHTML = `<a class="back" href="#kooklessen">← Alle kooklessen</a>
    <p class="badge"><span>${esc(L.event)}</span><span>${season(L.date)}</span><span>${L.dishes.length} gerechten</span></p>
    <h1>${fmtDate(L.date, "long").replace(/^(\S+) (.*)$/, "$1 <em>$2</em>")}</h1>`;
  $("#detail").innerHTML = `<div class="wrap dbody">
    <div class="sec-head"><h2>Het menu</h2></div>
    <div class="menu-list">${L.dishes.map(({r, l}, i) => {
      const otherDates = r.dated.filter(x => lkey(x) !== L.key);
      return `<a class="menu-item" href="#recept-${r.id}">
        <span class="num">${String(i+1).padStart(2,"0")}</span>
        <div><span class="course">${esc(cl(l.course))}</span><h3>${hl(l.title, T)}</h3>${otherDates.length ? `<p>Ook gemaakt op ${otherDates.map(x => fmtDate(x.date)).join(", ")}</p>` : ""}</div>
        <div class="tags">${otherDates.length ? `<span class="tagpill multi">${otherDates.length + 1} lessen</span>` : ""}${l.v == null ? '<span class="tagpill">geen recepttekst</span>' : ""}</div>
      </a>`; }).join("")}</div>
    <div class="pager">${older ? `<a class="btn-ghost" href="#les-${older.key}">← ${fmtDate(older.date)}</a>` : "<span></span>"}${newer ? `<a class="btn-ghost" href="#les-${newer.key}">${fmtDate(newer.date)} →</a>` : ""}</div>
  </div>`;
}

/* ---------- router ---------- */
let homeScroll = 0, onHome = true, curHash = "";
function show(page) {
  document.querySelectorAll("[data-page]").forEach(el => el.hidden = el.dataset.page !== page);
}
function route() {
  const h = curHash.replace(/^#/, "");
  let m;
  if ((m = h.match(/^recept-([a-z0-9-]+?)(?:~v(\d+))?$/)) && BYID[m[1]]) {
    if (onHome) homeScroll = scrollY;
    onHome = false; show("detail"); renderRecipe(BYID[m[1]], m[2] ? +m[2] : null);
    document.title = BYID[m[1]].title + " · Orgie der Wijzen"; scrollTo(0, 0); return;
  }
  if ((m = h.match(/^les-([0-9-]+(?:-ladiesnight)?)$/)) && LBYKEY[m[1]]) {
    if (onHome) homeScroll = scrollY;
    onHome = false; show("detail"); renderLesson(LBYKEY[m[1]]);
    document.title = "Kookles " + fmtDate(LBYKEY[m[1]].date) + " · Orgie der Wijzen"; scrollTo(0, 0); return;
  }
  const wasHome = onHome;
  onHome = true; show("home"); document.title = "Orgie der Wijzen";
  if (h === "kooklessen") setView("lessen");
  if (h === "recepten" && wasHome === false && st.view === "lessen") {}
  renderHome();
  const target = h === "kooklessen" ? "recepten" : h;
  if (target && document.getElementById(target)) {
    if (!wasHome && homeScroll && (h === "recepten" || h === "kooklessen")) scrollTo(0, homeScroll);
    else document.getElementById(target).scrollIntoView();
  } else scrollTo(0, wasHome ? scrollY : homeScroll);
}
function go(hash) {
  curHash = hash;
  try { history.pushState(null, "", hash || location.pathname + location.search); } catch {}
  route();
}
window.addEventListener("popstate", () => { curHash = location.hash; route(); });
window.addEventListener("hashchange", () => { if (location.hash !== curHash) { curHash = location.hash; route(); } });

function setView(v) { st.view = v; $("#tab-recepten").setAttribute("aria-pressed", v === "recepten"); $("#tab-lessen").setAttribute("aria-pressed", v === "lessen"); }

document.addEventListener("click", e => {
  const a = e.target.closest('a[href^="#"]');
  if (a && !e.metaKey && !e.ctrlKey) { e.preventDefault(); go(a.getAttribute("href") === "#" ? "" : a.getAttribute("href")); return; }
  const vb = e.target.closest("[data-ver]");
  if (vb) { const id = curHash.replace(/^#recept-/, "").replace(/~v\d+$/, ""); go(`#recept-${id}~v${vb.dataset.ver}`); return; }
  const rm = e.target.closest("[data-rm]");
  if (rm) { const k = rm.dataset.rm;
    if (k === "all") { FKEYS.forEach(f => st[f].clear()); st.q = ""; $("#q").value = ""; }
    else if (k === "q") { st.q = ""; $("#q").value = ""; }
    else st[k].delete(rm.dataset.v);
    st.limit = 60; renderHome(true); return; }
  const sm = e.target.closest("[data-more]");
  if (sm) { const k = sm.dataset.more; st.more.has(k) ? st.more.delete(k) : st.more.add(k); renderFilters(); return; }
  const gt = e.target.closest(".gtoggle");
  if (gt) { const k = gt.dataset.g; const open = st.closed.has(k); open ? st.closed.delete(k) : st.closed.add(k); gt.setAttribute("aria-expanded", open); $("#f-" + k).hidden = !open; return; }
  const lb = e.target.closest("[data-layout]");
  if (lb) { st.layout = lb.dataset.layout; document.querySelectorAll("[data-layout]").forEach(b => b.setAttribute("aria-pressed", b === lb)); renderHome(true); return; }
  if (e.target.id === "more") { st.limit += 60; renderHome(); }
});
document.addEventListener("keydown", e => {
  if (e.key === "/" && onHome && document.activeElement !== $("#q")) { e.preventDefault(); $("#q").focus(); }
});
let tmr; $("#q").addEventListener("input", e => { clearTimeout(tmr); tmr = setTimeout(() => { st.q = e.target.value; st.limit = 60; renderHome(true); }, 160); });
$("#sort").addEventListener("change", e => { st.sort = e.target.value; renderHome(true); });
$("#reset").addEventListener("click", () => { FKEYS.forEach(k => st[k].clear()); st.limit = 60; renderHome(true); });
$("#filters").addEventListener("change", e => { const i = e.target.closest("input[data-k]"); if (!i) return; const set = st[i.dataset.k]; i.checked ? set.add(i.dataset.v) : set.delete(i.dataset.v); st.limit = 60; renderHome(true); });
const closeFilters = () => { $("#filters").classList.remove("open"); $("#ftoggle").setAttribute("aria-expanded", false); document.body.style.overflow = ""; };
$("#fclose").addEventListener("click", closeFilters);
$("#fapply").addEventListener("click", () => { closeFilters(); $("#recepten .bar").scrollIntoView(); });
for (const v of ["recepten","lessen"]) $("#tab-" + v).addEventListener("click", () => { setView(v); renderHome(); });
$("#ftoggle").addEventListener("click", () => { $("#filters").classList.add("open"); $("#ftoggle").setAttribute("aria-expanded", true); document.body.style.overflow = "hidden"; });

fetch("recipes.json").then(r => r.json()).then(data => {
  R = data.map(prep);
  buildLessons();
  const years = LESSONS.map(L => +L.date.slice(0,4));
  const hero = BYID["sint-jakobsvruchten-met-venkel-en-roomsaus-met-pastis"];
  if (hero && hero.last) $("#platecap .pc-k").textContent = "Uit de kookles van " + fmtDate(hero.last, "long").replace(/^\S+ /, "");
  $("#n-rec").textContent = R.length + " recepten";
  $("#n-les").textContent = LESSONS.length + " kooklessen";
  $("#n-first").textContent = "Sinds " + Math.min(...years);
  $("#latest").innerHTML = LESSONS.slice(0, 6).map((L, i) => `<a class="pitem" href="#les-${L.key}">
    <span class="num">${String(i+1).padStart(2,"0")}</span>
    <div><span class="ev">${season(L.date)}</span><h3>${fmtDate(L.date, "long")}</h3></div>
    <ul>${L.dishes.slice(0, 4).map(d => `<li>${esc(d.l.title)}</li>`).join("")}${L.dishes.length > 4 ? `<li>+ ${L.dishes.length - 4} meer</li>` : ""}</ul>
  </a>`).join("");
  curHash = location.hash;
  route();
}).catch(err => { console.error(err); $("#count").textContent = "De recepten konden niet geladen worden. Herlaad de pagina."; });
</script>

</body>
</html>
