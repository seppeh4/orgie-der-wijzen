}
function buildLessons() {
  const m = new Map();
  for (const r of R) for (const l of r.lessons) {
    if (!l.date) continue;
    const k = lkey(l);
    if (!m.has(k)) m.set(k, { key: k, date: l.date, event: l.event, dishes: [], sources: new Set() });
    const L = m.get(k);
    L.dishes.push({ r, l });
